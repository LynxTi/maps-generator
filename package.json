{
  "name": "map-image-generator-backend",
  "version": "1.0.0",
  "description": "Map image generation API (MapLibre + Sharp + Prisma/MongoDB)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/api/server.js",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/api/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test test/unit/**/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/**/*.test.ts",
    "test:e2e": "node --import tsx --test test/e2e/**/*.test.ts",
    "test:coverage": "c8 --config c8.config.json npm run test:unit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "openapi:validate": "tsx scripts/validate-openapi.ts",
    "docs": "node scripts/open-docs.mjs",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "maps",
    "maplibre",
    "express",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@maplibre/maplibre-gl-native": "^6.4.1",
    "@prisma/client": "6.19.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pino": "^9.6.0",
    "sharp": "^0.33.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "c8": "^10.1.3",
    "eslint": "^9.22.0",
    "mongodb-memory-server": "^10.1.4",
    "pino-pretty": "^13.0.0",
    "prisma": "6.19.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
