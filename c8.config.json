{
  "include": [
    "src/config/**/*.ts",
    "src/lib/coordinates.ts",
    "src/lib/errors.ts",
    "src/lib/queue.ts",
    "src/services/**/*.ts",
    "src/storage/**/*.ts",
    "src/schemas/**/*.ts",
