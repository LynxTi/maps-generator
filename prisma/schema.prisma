generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum MapStatus {
  pending
  ready
  failed
}

enum JobStatus {
  queued
  running
  succeeded
  partial
  failed
  cancelled
}

enum JobItemStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum IdempotencyStatus {
  processing
  completed
}

model GeneratedMap {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  lat           Float
  lon           Float
  latKey        String
  lonKey        String
  place         String?
  filename      String
  urlPath       String
  renderVersion String
  status        MapStatus @default(pending)
  attempts      Int       @default(0)
  lastErrorCode String?
  lastErrorMsg  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([latKey, lonKey, renderVersion])
  @@index([createdAt])
  @@index([status])
  @@map("maps")
}

model MapJob {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  status          JobStatus @default(queued)
  total           Int
  queued          Int       @default(0)
  running         Int       @default(0)
  succeeded       Int       @default(0)
  failed          Int       @default(0)
  cancelled       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  finishedAt      DateTime?
  cancelRequested Boolean   @default(false)

  items MapJobItem[]

  @@index([status, createdAt])
  @@map("jobs")
}

model MapJobItem {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  jobId         String        @db.ObjectId
  job           MapJob        @relation(fields: [jobId], references: [id])
  index         Int
  lat           Float
  lon           Float
  place         String?
  status        JobItemStatus @default(queued)
  mapId         String?       @db.ObjectId
  url           String?
  cached        Boolean?
  attempts      Int           @default(0)
  lastErrorCode String?
  lastErrorMsg  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([jobId, status])
  @@index([jobId, index])
  @@index([status, updatedAt])
  @@map("job_items")
}

model IdempotencyRecord {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  key          String             @unique
  requestHash  String
  status       IdempotencyStatus  @default(processing)
  responseCode Int?
  responseBody Json?
  createdAt    DateTime           @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
  @@map("idempotency_records")
}
